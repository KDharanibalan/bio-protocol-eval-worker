  {
    "rule_id": "POL-CTRL-003",
    "category": "Experimental Design & Controls",
    "severity": "HIGH",
    "applies_when_keywords": ["assay", "atrophy", "treatment", "intervention", "rna-seq", "proteomics", "experimental design"],
    "required_evidence_groups": [
      ["vehicle control", "negative control", "untreated control", "calnexin"],
      ["replicate", "n =", "n=", "triplicate", "independent biological"]
    ],
    "description": "Experimental studies must specify appropriate negative/vehicle controls and biological replicate count (n >= 3) for statistical reproducibility."
  },
  {
    "rule_id": "POL-EVQC-004",
    "category": "EV Characterization QC",
    "severity": "MEDIUM",
    "applies_when_keywords": ["extracellular vesicle", "ev isolation", "ultracentrifugation", "exosome"],
    "required_evidence_groups": [
      ["cd63", "cd81", "tsg101"],
      ["nanosight", "nta", "cryo-em", "electron microscopy"]
    ],
    "description": "EV isolation workflows must verify canonical positive EV markers (CD63/CD81/TSG101) and biophysical sizing/morphology (NTA or Cryo-EM)."
  },
  {
    "rule_id": "POL-COA-005",
    "category": "Batch Release & COA Traceability",
    "severity": "HIGH",
    "applies_when_keywords": ["batch", "lot number", "certificate of analysis", "coa", "collagen-like protein", "scaffold"],
    "required_evidence_groups": [
      ["purity", "hplc", "maldi"],
      ["endotoxin", "lal", "eu/mg"],
      ["expiry", "retest date", "qa", "quality assurance"]
    ],
    "description": "Biomaterial batch release dossiers must document analytical purity, endotoxin testing (< 1.0 EU/mg), and expiry/QA sign-off."
  },
  {
    "rule_id": "POL-STOR-006",
    "category": "Storage & Stability Traceability",
    "severity": "MEDIUM",
    "applies_when_keywords": ["storage", "aliquot", "lyophilized", "stock solution", "ultracentrifugation"],
    "required_evidence_groups": [
      ["-80 c", "-20 c", "2 c to 8 c", "4 c"]
    ],
    "description": "Protocols must state explicit temperature-controlled storage conditions for biological samples or reagents."
  }
